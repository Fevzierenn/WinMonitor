/* WinMonitor stylesheet.
 *
 * Colour is reserved for meaning (green healthy, yellow warning, red
 * destructive, blue informational) and is applied in the widgets rather than
 * here, so this file is mostly structure.  Everything uses Textual's design
 * tokens ($surface, $panel, $accent...) so the interface follows the terminal
 * theme instead of hard-coding a dark palette.
 */

Screen {
    background: $surface;
    layers: base overlay;
}

#navbar {
    height: 1;
    padding: 0 1;
    background: $panel;
}

#views {
    height: 1fr;
}

#status {
    height: 1;
    padding: 0 1;
    background: $panel;
}

/* ------------------------------------------------------------- panels --- */

.panel {
    border: round $primary 40%;
    padding: 0 1;
    margin: 0 1 1 1;
    height: auto;
}

.panel-title {
    text-style: bold;
    color: $accent;
    padding: 0 0 1 0;
}

/* The two "top processes" panels sit side by side and must be the same
 * height, otherwise the shorter one leaves a hole; the height is fixed to the
 * six rows they show plus the title and border. */
.columns {
    height: 11;
}

.half {
    width: 1fr;
    height: 11;
}

.meters {
    height: auto;
}

/* The meters carry a trailing detail string ("8 physical / 16 logical"), so
 * they get more of the width than the single-value tiles beside them. */
.meter-column {
    width: 3fr;
    height: auto;
}

.tiles {
    width: 2fr;
    height: auto;
    padding: 0 0 0 2;
}

#system-panel {
    height: auto;
}

#dev-ports-panel {
    height: auto;
}

MeterBar, StatTile {
    height: 1;
}

/* -------------------------------------------------------------- tables --- */

TablePane {
    height: 1fr;
}

.table-caption {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

DataTable {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

DataTable > .datatable--cursor {
    background: $accent 40%;
    text-style: bold;
}

DataTable > .datatable--header {
    background: $panel;
    text-style: bold;
    color: $accent;
}

/* ------------------------------------------------------------ AI Usage --- */

AIUsagePane {
    height: 1fr;
    padding: 1;
}

AIUsagePane.loading {
    background: $error 10%;
}

#ai-filters {
    height: 3;
    background: $panel;
}

.ai-filter-label {
    width: 9;
    content-align: left middle;
    color: $accent;
}

#ai-source {
    width: 25;
}

#ai-report {
    width: 16;
}

#ai-refresh {
    margin-left: 2;
}

#ai-message, #ai-cost-note, #ai-totals {
    height: auto;
    padding: 0 1;
}

#ai-table {
    height: 1fr;
}

#ai-wait {
    height: 1fr;
    content-align: center middle;
    text-align: center;
    text-style: bold;
    color: $text;
    background: $error 20%;
    border: round $error 50%;
    margin: 1;
}

/* Per-source summary: one line per agent, so it grows with the number of
 * tools in use but never pushes the report table off a small terminal. */
#ai-sources {
    height: auto;
    max-height: 10;
    padding: 0 1;
    margin: 1 0 0 0;
    border-left: tall $accent 50%;
}

#ai-wait.hidden, #ai-table.hidden, #ai-sources.hidden {
    display: none;
}

/* ------------------------------------------------------------ Markdown --- */

MarkdownPane {
    height: 1fr;
    padding: 1;
}

#md-body {
    height: 1fr;
}

#md-sidebar {
    width: 36;
    height: 1fr;
    margin: 0 1 0 0;
}

#md-files {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#md-count, #md-path {
    height: auto;
    padding: 0 1;
}

#md-main {
    width: 1fr;
    height: 1fr;
}

#md-scroll, #md-fast {
    height: 1fr;
    border: round $primary 40%;
    scrollbar-size-vertical: 1;
}

/* Small files use the interactive renderer, large ones the fast line view. */
#md-scroll.hidden, #md-fast.hidden {
    display: none;
}

/* -------------------------------------------------------------- search --- */

#search-row {
    height: 3;
    padding: 0 1;
    background: $panel;
}

#search-row.hidden {
    display: none;
}

#search-label {
    width: 9;
    height: 3;
    content-align: left middle;
    color: $accent;
}

#search {
    width: 1fr;
}

/* ------------------------------------------------------------- dialogs --- */

/* The dialog must survive a small terminal: the warning text scrolls, while
 * the prompt, the input and the buttons stay pinned at the bottom where the
 * user can always reach them. */
#dialog {
    background: $panel;
    border: thick $primary;
    padding: 1 2;
    width: 80;
    max-width: 96%;
    height: auto;
    max-height: 96%;
    margin: 1 2;
}

#dialog.critical {
    border: thick $error;
}

#dialog-scroll {
    height: auto;
    max-height: 18;
    scrollbar-size-vertical: 1;
}

#dialog.details {
    width: 100;
    height: 90%;
}

#dialog.help {
    width: 72;
    height: auto;
    max-height: 90%;
}

#dialog-body {
    height: auto;
    padding: 0 0 1 0;
}

#dialog-force {
    height: auto;
    padding: 0 0 1 0;
}

#dialog-question {
    text-style: bold;
    padding: 1 0;
}

#dialog-input {
    margin: 0 0 1 0;
}

#dialog-buttons {
    height: auto;
    align: right middle;
}

#dialog-buttons Button {
    margin: 0 0 0 2;
}

#details-body {
    height: auto;
    padding: 0 1 1 0;
}

#help-body {
    height: auto;
}

#help-notes {
    height: auto;
    padding: 1 0;
}

ModalScreen {
    align: center middle;
    background: $surface 60%;
}
